{
  "name": "frame-chopper",
  "version": "1.6.1",
  "description": "Videos to frames converter",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "JavaRaf",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.framechopper.app",
    "productName": "Frame Chopper",
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*",
      "**/node_modules/@ffmpeg-installer/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "publish": null,
    "files": [
      "src/**/*",
      "electron/**/*",
      "!**/node_modules/*/{test,tests,doc,docs,example,examples,benchmark,performance}/**",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.map",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/docs/**",
      "!**/examples/**",
      "!**/.vscode/**",
      "!**/settings.json",
      "!**/.gitignore"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "wmv",
          "flv",
          "webm",
          "m4v",
          "mpg",
          "mpeg",
          "3gp",
          "ogv",
          "ts",
          "vob",
          "rm",
          "rmvb",
          "f4v"
        ],
        "name": "Vídeo file",
        "role": "Viewer"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video",
      "fileAssociations": [
        {
          "ext": "mp4",
          "name": "Vídeo file",
          "role": "Viewer"
        },
        {
          "ext": "mkv",
          "name": "Vídeo file",
          "role": "Viewer"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    }
  }
}